# ==============================================================================
# DQ Accelerator - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or Databricks environment:
# cp .env.example .env
# ==============================================================================

# --- Email Notification & SMTP Configuration ---
# 1. Gmail Preset:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USERNAME=your-email@gmail.com
#    SMTP_PASSWORD=your-gmail-app-password
#    SMTP_USE_TLS=true
#
# 2. Microsoft 365 / Outlook Preset:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USERNAME=your-work-email@company.com
#    SMTP_PASSWORD=your-password
#    SMTP_USE_TLS=true
#
# 3. SendGrid Preset:
#    SENDGRID_API_KEY=SG.your-sendgrid-api-key
#    # Or via SMTP:
#    # SMTP_HOST=smtp.sendgrid.net
#    # SMTP_PORT=587
#    # SMTP_USERNAME=apikey
#    # SMTP_PASSWORD=your-sendgrid-api-key

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=dq-alerts@company.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
SENDGRID_API_KEY=

# --- Databricks Integration (Optional: only needed if connecting to Unity Catalog) ---
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-sql-warehouse-id
# DATABRICKS_TOKEN=dapi-your-personal-access-token
# DQ_CATALOG_SCHEMA=your_catalog.your_schema
# DQ_JOB_ID=your-workflow-job-id

# --- Application Server Configuration ---
DATABRICKS_APP_PORT=8000
